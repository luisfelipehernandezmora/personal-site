---
const youtube = "";
---

<aside class="rail" aria-label="Interactive side process">
  <div class="rail-inner">
    <div class="panel" data-tetris-panel>
      <div class="panel__head">
        <span class="panel__label">
          <i class="status-dot" data-tetris-dot data-mode="agent" aria-hidden="true"></i>
          side process
        </span>
        <span class="panel__mode" data-tetris-mode aria-live="polite">agent · playing</span>
      </div>

      <div class="panel__stage">
        <canvas
          id="tetris"
          tabindex="0"
          role="img"
          aria-label="A self-playing Tetris board. Click it to take control with the arrow keys, space to drop, and Escape to hand control back to the agent."
        ></canvas>
      </div>

      <div class="panel__controls" aria-label="Game controls">
        <button type="button" data-action="left" aria-label="Move left">←</button>
        <button type="button" data-action="rotate" aria-label="Rotate">↻</button>
        <button type="button" data-action="right" aria-label="Move right">→</button>
        <button type="button" data-action="down" aria-label="Move down">↓</button>
        <button type="button" data-action="drop" aria-label="Drop">⤓</button>
      </div>

      <div class="panel__foot">
        <span class="hint" data-tetris-hint>click to take over</span>
        <span class="panel__count">lines <b data-tetris-lines>0</b></span>
      </div>
    </div>

    <p class="panel__caption">
      A small agent plays on its own.
      <span>Take the controls, then step away — it resumes.</span>
    </p>
  </div>
</aside>

<script>
  import { mountTetris } from "../scripts/tetris";
  mountTetris();
</script>
