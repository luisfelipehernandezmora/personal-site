---
import Base from "../layouts/Base.astro";
import TetrisPanel from "../components/TetrisPanel.astro";
import { site, work, roles, studies } from "../data/site";
import videoData from "../data/videos.json";

interface VideoItem {
  id: string;
  title: string;
  label?: string;
}

const videos = videoData as VideoItem[];
const year = new Date().getFullYear();
const youtube = site.links.youtube;
---

<Base
  title="Luis Felipe Hernández Mora — Applied AI Engineer"
  description="Applied AI engineer in San José, Costa Rica. Agentic systems, evaluation harnesses, and grounded tooling for high-stakes work — with a focus on medicine."
>
  <header class="site-header">
    <div class="shell site-header__inner">
      <a class="monogram" href="#top">LH — applied ai</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#work">Work</a>
        <a href="#path">Path</a>
        <a href="#videos">Videos</a>
        <a href="#contact">Contact</a>
        <a class="nav-cta" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </div>
  </header>

  <main id="main" class="shell">
    <div class="page" id="top">
      <section class="hero">
        <p class="eyebrow">
          <span>Applied AI</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{site.location}</span>
        </p>

        <h1 class="display hero__name">
          <span class="line"><span>Luis Felipe</span></span>
          <span class="line"><span>Hernández Mora<span style="color:var(--amber)">.</span></span></span>
        </h1>

        <p class="hero__lede">
          I build agentic AI systems that hold their ground — they show their sources,
          measure their own confidence, and hand control back when the stakes are high.
          The work I care about most is <strong>medicine</strong>.
        </p>

        <div class="hero__links">
          <a class="pill-link" href={site.links.linkedin} target="_blank" rel="noopener">
            LinkedIn <span class="arrow">↗</span>
          </a>
          <a class="pill-link" href={site.links.github} target="_blank" rel="noopener">
            GitHub <span class="arrow">↗</span>
          </a>
          <a class="pill-link" href={`mailto:${site.email}`}>
            Email <span class="arrow">↗</span>
          </a>
        </div>

        <a class="hero__scroll" href="#about">
          <span class="rule" aria-hidden="true"></span>
          <span>The reasoning</span>
        </a>
      </section>

      <TetrisPanel />

      <div class="rest">
        <section class="section" id="about">
          <div class="eyebrow"><span style="color:var(--amber)">01</span><span>Position</span></div>

          <p class="thesis__statement reveal">
            Medicine is where I want this work to <em>land</em> — because that is
            where a confident wrong answer costs the most.
          </p>

          <div class="thesis__body">
            <p class="reveal">
              I trained as a civil engineer, where a structure is honest: it either carries
              the load or it does not. That habit followed me into software. Before I trust a
              model with a decision, I want to know what it was given, what it ignored, and
              when it should stop.
            </p>
            <p class="reveal">
              In my current work I build production agentic systems — typed tools, approval
              gates, routing across providers, and evaluation harnesses that make an output
              accountable. <strong>The architecture is the part that is easy to describe.
              The hard part is deciding what a system should refuse to do.</strong>
            </p>
          </div>

          <div class="pull reveal">
            <span>//</span> My interest in medicine is not a pivot away from engineering.
            It is the same question at a higher stake: what does it take to trust a system
            when being wrong is expensive?
          </div>

        </section>

        <section class="section" id="work">
          <div class="section__head">
            <span class="section__index">02</span>
            <h2 class="section__title">Selected work</h2>
            <p class="section__note">
              Four systems from the last two years. Each exists because a model could not
              be trusted to run unsupervised.
            </p>
          </div>

          <div class="work-list">
            {work.map((w, i) => (
              <article class="work-row reveal" style={`--d:${i * 55}ms`}>
                <div class="work-row__num">{w.num}</div>
                <div>
                  <h3 class="work-row__title">{w.title}</h3>
                  <p class="work-row__meta">{w.meta}</p>
                  <p class="work-row__desc">{w.desc}</p>
                  <div class="work-row__tags">
                    {w.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="section path-section" id="path">
          <div class="path-draw" aria-hidden="true">
            <svg viewBox="0 0 64 1000" preserveAspectRatio="none">
              <path
                vector-effect="non-scaling-stroke"
                d="M 8 0 C 30 130, -2 250, 16 380 C 34 510, 0 620, 18 740 C 36 860, 4 930, 12 1000"
              />
            </svg>
          </div>

          <div class="section__head">
            <span class="section__index">03</span>
            <h2 class="section__title">Path</h2>
            <p class="section__note">
              Structural engineering, teaching, data pipelines, and now agents. The through-line
              is systems that have to work when someone is depending on them.
            </p>
          </div>

          <div class="path-group">
            <p class="path-group__label">
              <span class="path-group__mark path-group__mark--work" aria-hidden="true"></span>
              Work
            </p>
            <div class="timeline">
              {roles.map((e, i) => (
                <div class="tl-row tl-row--work reveal" style={`--d:${i * 40}ms`}>
                  <div class="tl-row__when">
                    <span class="tl-mark tl-mark--work" aria-hidden="true"></span>{e.when}
                  </div>
                  <div>
                    <p class="tl-row__role">{e.role}</p>
                    <p class="tl-row__org">{e.org}</p>
                    <p class="tl-row__desc">{e.desc}</p>
                    <p class="tl-row__note">{e.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="path-group">
            <p class="path-group__label">
              <span class="path-group__mark path-group__mark--study" aria-hidden="true"></span>
              Education
            </p>
            <div class="timeline">
              {studies.map((e, i) => (
                <div class="tl-row tl-row--study reveal" style={`--d:${i * 40}ms`}>
                  <div class="tl-row__when">
                    <span class="tl-mark tl-mark--study" aria-hidden="true"></span>{e.when}
                  </div>
                  <div>
                    <p class="tl-row__role">{e.role}</p>
                    <p class="tl-row__org">{e.org}</p>
                    <p class="tl-row__desc">{e.desc}</p>
                    <p class="tl-row__note">{e.note}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="section" id="videos">
          <div class="section__head">
            <span class="section__index">04</span>
            <h2 class="section__title">On camera</h2>
            <p class="section__note">
              Short notes on applied AI — the parts that are hard to write down.
            </p>
          </div>

          {videos.length === 0 ? (
            <div class="video-empty reveal">
              <span class="video-empty__mark" aria-hidden="true">
                <span class="video-empty__ring"></span>
                <span class="video-empty__play"></span>
              </span>
              <p class="video-empty__title">The channel is being set up.</p>
              <p class="video-empty__text">New episodes will appear here as they are published.</p>
            </div>
          ) : (
            <div class="video-grid">
              {videos.map((v, i) => (
                <a
                  class="video-card reveal"
                  href={`https://www.youtube.com/watch?v=${v.id}`}
                  target="_blank"
                  rel="noopener"
                  style={`--d:${i * 60}ms`}
                >
                  <div class="video-card__frame">
                    <img
                      class="video-card__thumb"
                      src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                    />
                    <span class="play-glyph" aria-hidden="true"></span>
                  </div>
                  <div class="video-card__body">
                    <h3 class="video-card__title">{v.title}</h3>
                    <p class="video-card__meta">{v.label || "Episode"}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </section>

        <section class="contact" id="contact">
          <p class="eyebrow"><span style="color:var(--amber)">05</span><span>Contact</span></p>
          <h2 class="contact__title display">Contact</h2>
          <p class="contact__lede">The line is open.</p>

          <svg class="svg-defs" width="0" height="0" aria-hidden="true">
            <symbol id="paper-plane" viewBox="0 0 24 24">
              <path d="M2 11.5 22 3l-7 18-3.6-7.2L2 11.5Z" />
              <path d="m11.4 13.8 10.6-10.8" />
            </symbol>
          </svg>

          <div class="email-orbit reveal">
            <div class="orbit orbit--1" aria-hidden="true">
              <svg class="plane" viewBox="0 0 24 24"><use href="#paper-plane" /></svg>
            </div>
            <div class="orbit orbit--2" aria-hidden="true">
              <svg class="plane" viewBox="0 0 24 24"><use href="#paper-plane" /></svg>
            </div>
            <div class="orbit orbit--3" aria-hidden="true">
              <svg class="plane" viewBox="0 0 24 24"><use href="#paper-plane" /></svg>
            </div>
            <a class="email-orbit__link" href={`mailto:${site.email}`}>
              {site.email}<span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="signal reveal" data-signal>
            <div class="signal__head">
              <span>signal / 001</span>
              <span class="signal__state">relay open</span>
            </div>

            <div class="signal__stage" data-signal-stage>
              <svg
                class="signal__svg"
                viewBox="0 0 800 220"
                preserveAspectRatio="xMidYMid meet"
                fill="none"
                role="img"
                aria-label="A telegraph key sends a spark along a wire, through a chip, to a telephone."
              >
                <defs>
                  <filter id="sparkGlow" x="-400%" y="-400%" width="900%" height="900%">
                    <feGaussianBlur stdDeviation="5" result="b" />
                    <feMerge>
                      <feMergeNode in="b" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                  <radialGradient id="sparkCore">
                    <stop offset="0" stop-color="#fff6e2" />
                    <stop offset="1" stop-color="#f0b968" />
                  </radialGradient>
                  <linearGradient id="chipFill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#17171a" />
                    <stop offset="1" stop-color="#0c0c0e" />
                  </linearGradient>
                </defs>

                <g class="circuit" stroke="rgba(236,231,221,0.09)" stroke-width="1">
                  <path d="M 340 94 H 250 V 52 H 152" />
                  <path d="M 340 148 H 266 V 192 H 168" />
                  <path d="M 460 94 H 556 V 50 H 654" />
                  <path d="M 460 148 H 546 V 190 H 648" />
                  <path d="M 400 78 V 42 H 300" />
                  <path d="M 400 164 V 196 H 502" />
                  <circle cx="152" cy="52" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                  <circle cx="168" cy="192" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                  <circle cx="654" cy="50" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                  <circle cx="648" cy="190" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                  <circle cx="300" cy="42" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                  <circle cx="502" cy="196" r="2.2" fill="rgba(236,231,221,.22)" stroke="none" />
                </g>

                <path
                  class="signal__wire"
                  data-signal-path
                  d="M 150 147 C 218 147 250 112 330 112 L 470 112 C 552 112 588 147 650 147"
                  stroke="rgba(217,154,78,0.32)"
                  stroke-width="1.2"
                />

                <g
                  class="telegraph"
                  stroke="rgba(236,231,221,0.55)"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M 38 182 H 154" />
                  <path d="M 52 182 V 172 H 140 V 182" />
                  <g class="telegraph__lever">
                    <path d="M 58 171 L 126 138" />
                    <circle cx="58" cy="171" r="5" />
                    <circle
                      cx="132"
                      cy="135"
                      r="7"
                      fill="rgba(217,154,78,0.16)"
                      stroke="rgba(217,154,78,0.75)"
                    />
                    <path d="M 136 140 L 150 147" stroke="rgba(217,154,78,0.9)" />
                  </g>
                  <path d="M 46 186 L 40 178" stroke="rgba(236,231,221,0.22)" />
                  <path d="M 146 186 L 152 178" stroke="rgba(236,231,221,0.22)" />
                </g>

                <g
                  class="phone"
                  stroke="rgba(236,231,221,0.55)"
                  stroke-width="1.4"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                >
                  <path d="M 652 182 H 762 L 750 132 H 664 Z" />
                  <path d="M 664 132 C 664 112, 698 106, 722 116" />
                  <circle cx="666" cy="129" r="7" fill="rgba(236,231,221,0.07)" />
                  <circle cx="729" cy="119" r="7" fill="rgba(236,231,221,0.07)" />
                  <circle cx="710" cy="158" r="13" stroke="rgba(236,231,221,0.3)" />
                  <circle cx="710" cy="158" r="2" fill="rgba(236,231,221,0.3)" stroke="none" />
                </g>
                <g
                  class="phone__waves"
                  stroke="rgba(217,154,78,0.55)"
                  stroke-width="1.2"
                  stroke-linecap="round"
                >
                  <path d="M 752 112 C 762 118, 766 126, 762 136" />
                  <path d="M 762 102 C 778 111, 784 128, 774 144" />
                </g>

                <g class="chip">
                  <rect
                    x="338"
                    y="76"
                    width="124"
                    height="90"
                    rx="5"
                    fill="url(#chipFill)"
                    stroke="rgba(236,231,221,0.28)"
                  />
                  <g stroke="rgba(236,231,221,0.22)" stroke-width="1" stroke-linecap="round">
                    <path d="M 338 92 H 326" />
                    <path d="M 338 108 H 326" />
                    <path d="M 338 124 H 326" />
                    <path d="M 338 140 H 326" />
                    <path d="M 338 156 H 326" />
                    <path d="M 462 92 H 474" />
                    <path d="M 462 108 H 474" />
                    <path d="M 462 124 H 474" />
                    <path d="M 462 140 H 474" />
                    <path d="M 462 156 H 474" />
                    <path d="M 372 76 V 66" />
                    <path d="M 392 76 V 66" />
                    <path d="M 412 76 V 66" />
                    <path d="M 432 76 V 66" />
                    <path d="M 372 166 V 176" />
                    <path d="M 392 166 V 176" />
                    <path d="M 412 166 V 176" />
                    <path d="M 432 166 V 176" />
                  </g>
                  <circle cx="351" cy="89" r="2.2" fill="rgba(217,154,78,0.85)" stroke="none" />
                  <g
                    class="chip__traces"
                    stroke="rgba(217,154,78,0.5)"
                    stroke-width="1"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M 362 116 H 396 V 102 H 428" />
                    <path d="M 362 134 H 386 V 146 H 428" />
                    <rect x="402" y="118" width="30" height="22" rx="2" />
                    <path d="M 402 124 H 432" stroke="rgba(217,154,78,0.3)" />
                  </g>
                </g>

                <g class="spark" data-spark transform="translate(150 147)" filter="url(#sparkGlow)">
                  <circle r="11" fill="rgba(240,185,104,0.12)" />
                  <circle r="3.2" fill="url(#sparkCore)" />
                </g>
              </svg>

              <svg
                class="signal__svg signal__svg--hot"
                viewBox="0 0 800 220"
                preserveAspectRatio="xMidYMid meet"
                fill="none"
                aria-hidden="true"
              >
                <g stroke="#f0b968" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M 340 94 H 250 V 52 H 152" />
                  <path d="M 340 148 H 266 V 192 H 168" />
                  <path d="M 460 94 H 556 V 50 H 654" />
                  <path d="M 460 148 H 546 V 190 H 648" />
                  <path d="M 400 78 V 42 H 300" />
                  <path d="M 400 164 V 196 H 502" />
                  <path d="M 150 147 C 218 147 250 112 330 112 L 470 112 C 552 112 588 147 650 147" />
                  <rect x="338" y="76" width="124" height="90" rx="5" />
                  <path d="M 338 92 H 326" />
                  <path d="M 338 108 H 326" />
                  <path d="M 338 124 H 326" />
                  <path d="M 338 140 H 326" />
                  <path d="M 338 156 H 326" />
                  <path d="M 462 92 H 474" />
                  <path d="M 462 108 H 474" />
                  <path d="M 462 124 H 474" />
                  <path d="M 462 140 H 474" />
                  <path d="M 462 156 H 474" />
                  <path d="M 362 116 H 396 V 102 H 428" />
                  <path d="M 362 134 H 386 V 146 H 428" />
                </g>
              </svg>
            </div>
          </div>

          <div class="contact__grid contact__grid--three">
            <a class="contact__item" href={site.links.linkedin} target="_blank" rel="noopener">
              <span class="contact__label">LinkedIn</span>
              <span class="contact__value">luis-felipe-hernandez-mora<span>↗</span></span>
            </a>
            <a class="contact__item" href={site.links.github} target="_blank" rel="noopener">
              <span class="contact__label">GitHub</span>
              <span class="contact__value">luisfelipehernandezmora<span>↗</span></span>
            </a>
            <a
              class="contact__item"
              href={youtube || `mailto:${site.email}?subject=YouTube%20channel`}
              target={youtube ? "_blank" : undefined}
              rel={youtube ? "noopener" : undefined}
            >
              <span class="contact__label">YouTube</span>
              <span class="contact__value">{youtube ? "Watch the channel" : "Opening soon"}<span>↗</span></span>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="shell site-footer__inner">
      <span>© {year} {site.name}</span>
      <span>{site.location} · Built with Astro, deployed on Vercel</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>

  <script>
    import { mountSignal } from "../scripts/signal";

    mountSignal();

    const reveals = document.querySelectorAll<HTMLElement>(".reveal");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce) {
      reveals.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      reveals.forEach((el) => io.observe(el));
    }

    const pathSection = document.querySelector<HTMLElement>(".path-section");
    if (pathSection) {
      if (reduce) {
        pathSection.classList.add("is-drawn");
      } else {
        const pathIo = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            pathSection.classList.add("is-drawn");
            pathIo.disconnect();
          },
          { threshold: 0.12 },
        );
        pathIo.observe(pathSection);
      }
    }
  </script>
</Base>
