---
import Base from "../layouts/Base.astro";
import TetrisPanel from "../components/TetrisPanel.astro";
import { site, work, roles, studies } from "../data/site";
import videoData from "../data/videos.json";
import resourceData from "../data/resources.json";

interface VideoItem {
  id: string;
  title: string;
  label?: string;
}

interface ResourceItem {
  title: string;
  desc: string;
  file: string;
  status: string;
}

const videos = videoData as VideoItem[];
const resources = resourceData as ResourceItem[];
const year = new Date().getFullYear();
const youtube = site.links.youtube;

const footprints = Array.from({ length: 34 }, (_, i) => {
  const t = i / 33;
  const wave = Math.sin(t * Math.PI * 2.3) * 5;
  return {
    left: 9 + (i % 2 === 0 ? 0 : 8) + wave,
    top: 3 + t * 94,
    rot: (i % 2 === 0 ? -10 : 10) + wave * 0.6,
  };
});
---

<Base
  title="Luis Felipe Hernández Mora — Applied AI & Civil Engineer"
  description="Applied AI engineer and civil engineer in San José, Costa Rica. Agentic systems, evaluation, and grounded tooling for education and health."
>
  <header class="site-header">
    <div class="shell site-header__inner">
      <a class="monogram" href="#top">LH — applied ai</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="#work">Repos</a>
        <a href="#path">Path</a>
        <a href="#videos">Videos</a>
        <a href="#downloads">Guides</a>
        <a href="#ai-notes">Notes</a>
        <a href="#contact">Contact</a>
        <a class="nav-cta" href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </div>
  </header>

  <main id="main" class="shell">
    <div class="page" id="top">
      <section class="hero">
        <p class="eyebrow">
          <span>Applied AI</span>
          <span class="dot" aria-hidden="true"></span>
          <span>{site.location}</span>
        </p>

        <h1 class="display hero__name">
          <span class="line"><span>Luis Felipe</span></span>
          <span class="line"><span>Hernández Mora<span style="color:var(--amber)">.</span></span></span>
        </h1>

        <p class="hero__lede">
          I build agentic AI systems that hold their ground — they show their sources,
          measure their own confidence, and hand control back when the stakes are high.
          The work I care about most is <strong>technology for good: health and education</strong>.
        </p>

        <div class="hero__links">
          <a class="pill-link" href={site.links.linkedin} target="_blank" rel="noopener">
            LinkedIn <span class="arrow">↗</span>
          </a>
          <a class="pill-link" href={site.links.github} target="_blank" rel="noopener">
            GitHub <span class="arrow">↗</span>
          </a>
          <a class="pill-link" href={`mailto:${site.email}`}>
            Email <span class="arrow">↗</span>
          </a>
        </div>

        <a class="hero__scroll" href="#about">
          <span class="rule" aria-hidden="true"></span>
          <span>Interests</span>
        </a>
      </section>

      <TetrisPanel />

      <div class="rest">
        <section class="section" id="about">
          <div class="interests reveal">
            <p class="interests__label">Interests</p>
            <ul class="interests__list">
              <li><span>01</span>Technology for good</li>
              <li><span>02</span>Education</li>
              <li><span>03</span>Health</li>
            </ul>
          </div>
        </section>

        <section class="section" id="work">
          <div class="section__head">
            <span class="section__index">02</span>
            <h2 class="section__title">Public repos</h2>
            <p class="section__note">
              Two public builds you can read today. Both are places where a model has to
              work with constraints, tools, and someone else in the loop.
            </p>
          </div>

          <div class="work-list">
            {work.map((w, i) => (
              <a
                class="work-row reveal"
                href={w.url}
                target="_blank"
                rel="noopener"
                style={`--d:${i * 55}ms`}
              >
                <div class="work-row__num">{w.num}</div>
                <div>
                  <h3 class="work-row__title">{w.title}</h3>
                  <p class="work-row__meta">{w.meta}<span aria-hidden="true"> ↗</span></p>
                  <p class="work-row__desc">{w.desc}</p>
                  <div class="work-row__tags">
                    {w.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                </div>
              </a>
            ))}
          </div>

          <p class="work-more reveal">(more coming soon)</p>
        </section>

        <section class="section path-section" id="path">
          <div class="section__head">
            <span class="section__index">03</span>
            <h2 class="section__title">Path</h2>
            <p class="section__note">
              Structural engineering, teaching, data pipelines, and now agents. Open either
              group for the details.
            </p>
          </div>

          <div class="path-body">
            <div class="footprints" aria-hidden="true">
              {footprints.map((f) => (
                <svg
                  class="foot"
                  style={`left:${f.left}px;top:${f.top}%;--rot:${f.rot}deg`}
                  viewBox="0 0 14 22"
                  aria-hidden="true"
                >
                  <ellipse cx="7" cy="7.5" rx="4" ry="6" />
                  <ellipse cx="7" cy="17.5" rx="2.4" ry="2.9" />
                </svg>
              ))}
            </div>

            <details class="path-group" data-path-details>
              <summary class="path-group__summary">
                <span class="path-group__mark path-group__mark--work" aria-hidden="true"></span>
                <span class="path-group__name">Work</span>
                <span class="path-group__count">{roles.length} roles</span>
                <span class="path-group__toggle" aria-hidden="true"></span>
              </summary>
              <div class="timeline">
                {roles.map((e, i) => (
                  <div class="tl-row tl-row--work reveal" style={`--d:${i * 40}ms`}>
                    <div class="tl-row__when">
                      <span class="tl-mark tl-mark--work" aria-hidden="true"></span>{e.when}
                    </div>
                    <div>
                      <p class="tl-row__role">{e.role}</p>
                      <p class="tl-row__org">{e.org}</p>
                      <p class="tl-row__desc">{e.desc}</p>
                      <p class="tl-row__note">{e.note}</p>
                    </div>
                  </div>
                ))}
              </div>
            </details>

            <details class="path-group" data-path-details>
              <summary class="path-group__summary">
                <span class="path-group__mark path-group__mark--study" aria-hidden="true"></span>
                <span class="path-group__name">Education</span>
                <span class="path-group__count">{studies.length} entries</span>
                <span class="path-group__toggle" aria-hidden="true"></span>
              </summary>
              <div class="timeline">
                {studies.map((e, i) => (
                  <div class="tl-row tl-row--study reveal" style={`--d:${i * 40}ms`}>
                    <div class="tl-row__when">
                      <span class="tl-mark tl-mark--study" aria-hidden="true"></span>{e.when}
                    </div>
                    <div>
                      <p class="tl-row__role">{e.role}</p>
                      <p class="tl-row__org">{e.org}</p>
                      <p class="tl-row__desc">{e.desc}</p>
                      <p class="tl-row__note">{e.note}</p>
                    </div>
                  </div>
                ))}
              </div>
            </details>
          </div>
        </section>

        <section class="section" id="videos">
          <div class="section__head">
            <span class="section__index">04</span>
            <h2 class="section__title">On camera</h2>
            <p class="section__note">
              Short notes on applied AI — the parts that are hard to write down.
            </p>
          </div>

          {videos.length === 0 ? (
            <div class="video-empty reveal">
              <span class="video-empty__mark" aria-hidden="true">
                <span class="video-empty__ring"></span>
                <span class="video-empty__play"></span>
              </span>
              <p class="video-empty__title">The channel is being set up.</p>
              <p class="video-empty__text">New episodes will appear here as they are published.</p>
            </div>
          ) : (
            <div class="video-grid">
              {videos.map((v, i) => (
                <a
                  class="video-card reveal"
                  href={`https://www.youtube.com/watch?v=${v.id}`}
                  target="_blank"
                  rel="noopener"
                  style={`--d:${i * 60}ms`}
                >
                  <div class="video-card__frame">
                    <img
                      class="video-card__thumb"
                      src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                      alt=""
                      loading="lazy"
                    />
                    <span class="play-glyph" aria-hidden="true"></span>
                  </div>
                  <div class="video-card__body">
                    <h3 class="video-card__title">{v.title}</h3>
                    <p class="video-card__meta">{v.label || "Episode"}</p>
                  </div>
                </a>
              ))}
            </div>
          )}
        </section>

        <section class="section" id="downloads">
          <div class="section__head">
            <span class="section__index">05</span>
            <h2 class="section__title">Take it with you</h2>
            <p class="section__note">
              Short guides on applied AI. Written to be printed, annotated, and kept on a desk.
            </p>
          </div>

          {resources.length === 0 ? (
            <div class="video-empty reveal">
              <p class="video-empty__title">Guides are being written.</p>
              <p class="video-empty__text">New walkthroughs will appear here.</p>
            </div>
          ) : (
          <div class="resource-grid">
            {resources.map((r, i) =>
              r.file ? (
                <a
                  class="resource-card reveal"
                  href={r.file}
                  download
                  style={`--d:${i * 50}ms`}
                >
                  <div class="resource-card__top">
                    <svg class="resource-card__icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 2.5h8l5 5v14H6z" />
                      <path d="M14 2.5v5h5" />
                      <path d="M9 13h7M9 16.5h5" />
                    </svg>
                    <span class="resource-card__index">{String(i + 1).padStart(2, "0")} / PDF</span>
                  </div>
                  <h3 class="resource-card__title">{r.title}</h3>
                  <p class="resource-card__desc">{r.desc}</p>
                  <p class="resource-card__meta">Download ↗</p>
                </a>
              ) : (
                <div
                  class="resource-card resource-card--soon reveal"
                  style={`--d:${i * 50}ms`}
                >
                  <div class="resource-card__top">
                    <svg class="resource-card__icon" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 2.5h8l5 5v14H6z" />
                      <path d="M14 2.5v5h5" />
                      <path d="M9 13h7M9 16.5h5" />
                    </svg>
                    <span class="resource-card__index">{String(i + 1).padStart(2, "0")} / PDF</span>
                  </div>
                  <h3 class="resource-card__title">{r.title}</h3>
                  <p class="resource-card__desc">{r.desc}</p>
                  <p class="resource-card__meta">{r.status}</p>
                </div>
              ),
            )}
          </div>
          )}
        </section>

        <section class="section" id="ai-notes">
          <div class="section__head">
            <span class="section__index">06</span>
            <h2 class="section__title">
              What is new on AI? <span class="coming">(coming soon)</span>
            </h2>
            <p class="section__note">
              A weekly read on what actually changed, with sources and a video.
            </p>
          </div>
          <div class="soon-panel reveal">
            <span class="soon-panel__label">In preparation</span>
            <p>One useful update a week, filtered for signal instead of noise.</p>
          </div>
        </section>

        <section class="section" id="ai-claims">
          <div class="section__head">
            <span class="section__index">07</span>
            <h2 class="section__title">
              Everyone says so much about AI — is all that true?
              <span class="coming">(coming soon)</span>
            </h2>
            <p class="section__note">
              Claim-by-claim checks on the things people keep repeating.
            </p>
          </div>
          <div class="soon-panel reveal">
            <span class="soon-panel__label">In preparation</span>
            <p>
              Short, sourced answers to the loudest claims, without the hype in either
              direction.
            </p>
          </div>
        </section>

        <section class="section" id="ask">
          <div class="section__head">
            <span class="section__index">08</span>
            <h2 class="section__title">Want to hear about something?</h2>
            <p class="section__note">
              Write to me. I’ll do the research and publish a commented answer here.
            </p>
          </div>
          <a
            class="ask-card reveal"
            href={`mailto:${site.email}?subject=Topic%20for%20the%20AI%20notes`}
          >
            <span class="ask-card__label">Send a question</span>
            <span class="ask-card__email">{site.email}</span>
            <span class="ask-card__arrow" aria-hidden="true">↗</span>
          </a>
        </section>

        <section class="contact" id="contact">
          <p class="eyebrow"><span style="color:var(--amber)">09</span><span>Contact</span></p>
          <h2 class="contact__title display">Contact</h2>
          <p class="contact__lede">For conversations about applied AI, education, and health.</p>

          <div class="contact-cards" data-contact-cards>
            <svg class="contact-net" data-contact-net aria-hidden="true"></svg>

            <a class="contact-card" href={`mailto:${site.email}`} data-card>
              <span class="contact-card__top">
                <span class="contact-card__label">Email</span>
                <span class="contact-card__index">01</span>
              </span>
              <span class="contact-card__value">{site.email}</span>
              <span class="contact-card__arrow" aria-hidden="true">↗</span>
            </a>

            <a
              class="contact-card"
              href={site.links.github}
              target="_blank"
              rel="noopener"
              data-card
            >
              <span class="contact-card__top">
                <span class="contact-card__label">GitHub</span>
                <span class="contact-card__index">02</span>
              </span>
              <span class="contact-card__value">luisfelipehernandezmora</span>
              <span class="contact-card__arrow" aria-hidden="true">↗</span>
            </a>

            <a
              class="contact-card"
              href={site.links.linkedin}
              target="_blank"
              rel="noopener"
              data-card
            >
              <span class="contact-card__top">
                <span class="contact-card__label">LinkedIn</span>
                <span class="contact-card__index">03</span>
              </span>
              <span class="contact-card__value">luis-felipe-hernandez-mora</span>
              <span class="contact-card__arrow" aria-hidden="true">↗</span>
            </a>

            {youtube ? (
              <a
                class="contact-card"
                href={youtube}
                target="_blank"
                rel="noopener"
                data-card
              >
                <span class="contact-card__top">
                  <span class="contact-card__label">YouTube</span>
                  <span class="contact-card__index">04</span>
                </span>
                <span class="contact-card__value">Watch the channel</span>
                <span class="contact-card__arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <div class="contact-card contact-card--soon" data-card>
                <span class="contact-card__top">
                  <span class="contact-card__label">YouTube</span>
                  <span class="contact-card__index">04</span>
                </span>
                <span class="contact-card__value">Opening soon</span>
                <span class="contact-card__arrow" aria-hidden="true">↗</span>
              </div>
            )}
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="shell site-footer__inner">
      <span>© {year} {site.name}</span>
      <span>{site.location}</span>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>

  <script>
    import { mountContactNet } from "../scripts/contact-net";

    mountContactNet();

    const reveals = document.querySelectorAll<HTMLElement>(".reveal");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (reduce) {
      reveals.forEach((el) => el.classList.add("in"));
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("in");
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
      );
      reveals.forEach((el) => io.observe(el));
    }

    const prints = Array.from(document.querySelectorAll<SVGElement>(".foot"));

    if (prints.length) {
      if (reduce) {
        prints.forEach((el) => (el.style.opacity = "0.42"));
      } else {
        let ticking = false;
        let idleTimer = 0;
        const idleTimers: number[] = [];
        const revealQueue: SVGElement[] = [];
        let revealTimer = 0;

        const revealNext = () => {
          const el = revealQueue.shift();
          if (el && el.getAttribute("data-shown") === "1" && el.style.opacity === "0") {
            el.style.opacity = "0.55";
          }
          revealTimer = revealQueue.length ? window.setTimeout(revealNext, 95) : 0;
        };

        const updatePrints = () => {
          ticking = false;
          const vh = window.innerHeight;

          for (const el of prints) {
            const rect = el.getBoundingClientRect();
            let target = 0;

            if (rect.top < vh * 0.86 && rect.bottom > 64) {
              target = Math.min(1, (vh * 0.86 - rect.top) / 90);
              target *= Math.min(1, Math.max(0, (rect.bottom - 64) / 70));
              target *= 0.55;
            }

            if (target > 0.01) {
              if (el.getAttribute("data-shown") === "1") {
                el.style.opacity = target.toFixed(3);
              } else {
                el.setAttribute("data-shown", "1");
                el.style.opacity = "0";
                revealQueue.push(el);
                if (!revealTimer) revealTimer = window.setTimeout(revealNext, 60);
              }
            } else {
              el.style.opacity = "0";
              el.removeAttribute("data-shown");
            }
          }
        };

        const clearIdle = () => {
          window.clearTimeout(idleTimer);
          while (idleTimers.length) {
            window.clearTimeout(idleTimers.pop());
          }
        };

        const dissolve = () => {
          revealQueue.length = 0;
          window.clearTimeout(revealTimer);
          revealTimer = 0;

          const vh = window.innerHeight;
          const visible = prints
            .map((el) => ({
              el,
              top: el.getBoundingClientRect().top,
              opacity: parseFloat(el.style.opacity || "0"),
            }))
            .filter((item) => item.opacity > 0.02 && item.top < vh)
            .sort((a, b) => b.top - a.top);

          visible.forEach((item, index) => {
            idleTimers.push(
              window.setTimeout(() => {
                item.el.style.opacity = "0";
                item.el.removeAttribute("data-shown");
              }, index * 110),
            );
          });
        };

        const wake = () => {
          clearIdle();
          idleTimer = window.setTimeout(dissolve, 1400);
        };

        const onScroll = () => {
          wake();
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(updatePrints);
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll);
        updatePrints();
        wake();
      }
    }

    document.querySelectorAll<HTMLDetailsElement>("[data-path-details]").forEach((details) => {
      details.addEventListener("toggle", () => {
        if (!details.open) return;
        details.querySelectorAll(".reveal").forEach((el) => el.classList.add("in"));
        requestAnimationFrame(() => {
          window.dispatchEvent(new Event("scroll"));
          window.setTimeout(() => window.dispatchEvent(new Event("scroll")), 90);
        });
      });
    });
  </script>
</Base>
