---
import "../styles/global.css";
import videoData from "../data/videos.json";
import resourceData from "../data/resources.json";

const initialJson = JSON.stringify(videoData).replace(/</g, "\\u003c");
const initialResourcesJson = JSON.stringify(resourceData).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <title>Video admin — Luis Felipe Hernández Mora</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="monogram" href="/">LH — applied ai</a>
        <nav class="site-nav" aria-label="Admin">
          <a class="admin-back" href="/">← Back to site</a>
        </nav>
      </div>
    </header>

    <main class="admin">
      <div class="admin__intro">
        <p class="eyebrow"><span style="color:var(--amber)">admin</span><span>Videos</span></p>
        <h1 class="admin__title display">Video admin</h1>
        <p class="admin__lede">
          Paste a YouTube link, give it a title, and download the updated list. No account
          or token required.
        </p>
      </div>

      <section class="admin-card">
        <p class="admin-card__title">Add a video</p>
        <form class="admin-form" data-add-form>
          <div class="admin-grid">
            <div class="admin-field">
              <label for="url">YouTube URL</label>
              <input id="url" required placeholder="https://www.youtube.com/watch?v=…" />
            </div>
            <div class="admin-field">
              <label for="title">Title</label>
              <input id="title" required placeholder="What the episode is about" />
            </div>
          </div>
          <div class="admin-grid">
            <div class="admin-field">
              <label for="label">Episode label <span>optional</span></label>
              <input id="label" placeholder="Episode 01" />
            </div>
            <div class="admin-field admin-field--submit">
              <button class="admin-btn admin-btn--primary" type="submit">Add video</button>
            </div>
          </div>
        </form>

        <div class="admin-preview" data-preview hidden>
          <img data-preview-thumb alt="" />
          <div>
            <p class="admin-preview__title" data-preview-title></p>
            <p class="admin-preview__meta" data-preview-meta></p>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__head">
          <p class="admin-card__title">Videos</p>
          <span class="admin-count" data-count>0</span>
        </div>
        <div class="admin-list" data-list></div>
      </section>

      <div class="admin-actions">
        <button class="admin-btn admin-btn--primary" type="button" data-download-videos>
          Download videos.json
        </button>
        <button class="admin-btn" type="button" data-copy-videos>Copy videos JSON</button>
      </div>

      <section class="admin-card">
        <p class="admin-card__title">Add a guide</p>
        <form class="admin-form" data-guide-form>
          <div class="admin-field">
            <label for="guide-title">Title</label>
            <input id="guide-title" required placeholder="What the guide covers" />
          </div>
          <div class="admin-field">
            <label for="guide-desc">Description</label>
            <input id="guide-desc" required placeholder="One or two sentences" />
          </div>
          <div class="admin-field">
            <label for="guide-file">File path <span>optional</span></label>
            <input id="guide-file" placeholder="/downloads/guide.pdf" />
          </div>
          <div class="admin-grid">
            <div class="admin-field">
              <label for="guide-status">Status</label>
              <select id="guide-status">
                <option>Coming soon</option>
                <option>In preparation</option>
                <option>Available</option>
              </select>
            </div>
            <div class="admin-field admin-field--submit">
              <button class="admin-btn admin-btn--primary" type="submit">Add guide</button>
            </div>
          </div>
        </form>
      </section>

      <section class="admin-card">
        <div class="admin-card__head">
          <p class="admin-card__title">Guides</p>
          <span class="admin-count" data-guide-count>0</span>
        </div>
        <div class="admin-list" data-guide-list></div>
      </section>

      <div class="admin-actions">
        <button class="admin-btn admin-btn--primary" type="button" data-download-resources>
          Download resources.json
        </button>
        <button class="admin-btn" type="button" data-copy-resources>Copy guides JSON</button>
        <button class="admin-btn" type="button" data-reset>Reset all</button>
      </div>

      <p class="admin-status" data-status role="status" aria-live="polite"></p>

      <div class="admin-note">
        <p>
          Replace <code>src/data/videos.json</code> and <code>src/data/resources.json</code>
          with the downloaded files, then commit. Vercel rebuilds and the site updates.
        </p>
        <p>Edits stay in this browser until you download the files.</p>
      </div>
    </main>

    <script type="application/json" id="initial-videos" set:html={initialJson}></script>
    <script type="application/json" id="initial-resources" set:html={initialResourcesJson}></script>

    <script>
      interface Video {
        id: string;
        title: string;
        label?: string;
      }

      interface Guide {
        title: string;
        desc: string;
        file: string;
        status: string;
      }

      const VIDEO_KEY = "lhm-admin-videos";
      const GUIDE_KEY = "lhm-admin-resources";

      const $ = <T extends HTMLElement>(selector: string): T | null =>
        document.querySelector<T>(selector);

      const listEl = $("[data-list]");
      const countEl = $("[data-count]");
      const preview = $("[data-preview]");
      const previewThumb = $<HTMLImageElement>("[data-preview-thumb]");
      const previewTitle = $("[data-preview-title]");
      const previewMeta = $("[data-preview-meta]");
      const statusEl = $("[data-status]");

      const addForm = $<HTMLFormElement>("[data-add-form]");
      const urlInput = $<HTMLInputElement>("#url");
      const titleInput = $<HTMLInputElement>("#title");
      const labelInput = $<HTMLInputElement>("#label");

      const guideListEl = $("[data-guide-list]");
      const guideCountEl = $("[data-guide-count]");
      const guideForm = $<HTMLFormElement>("[data-guide-form]");
      const guideTitleInput = $<HTMLInputElement>("#guide-title");
      const guideDescInput = $<HTMLInputElement>("#guide-desc");
      const guideStatusInput = $<HTMLSelectElement>("#guide-status");
      const guideFileInput = $<HTMLInputElement>("#guide-file");

      const initialRaw = document.getElementById("initial-videos")?.textContent || "[]";
      const initialVideos = JSON.parse(initialRaw) as Video[];
      const initialResourcesRaw =
        document.getElementById("initial-resources")?.textContent || "[]";
      const initialResources = JSON.parse(initialResourcesRaw) as Guide[];

      let videos: Video[] = initialVideos.slice();
      let guides: Guide[] = initialResources.slice();
      let loadedFromStorage = false;
      let guidesLoadedFromStorage = false;

      try {
        const stored = localStorage.getItem(VIDEO_KEY);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            videos = parsed.filter(
              (item): item is Video =>
                item && typeof item.id === "string" && typeof item.title === "string",
            );
            loadedFromStorage = true;
          }
        }
      } catch {
        videos = initialVideos.slice();
      }

      try {
        const stored = localStorage.getItem(GUIDE_KEY);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed)) {
            guides = parsed
              .filter(
                (item): item is Guide =>
                  item && typeof item.title === "string" && typeof item.desc === "string",
              )
              .map((item) => ({
                title: item.title,
                desc: item.desc,
                file: typeof item.file === "string" ? item.file : "",
                status: typeof item.status === "string" ? item.status : "Coming soon",
              }));
            guidesLoadedFromStorage = true;
          }
        }
      } catch {
        guides = initialResources.slice();
      }

      function setStatus(message: string, kind: "ok" | "error" | "" = ""): void {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.dataset.kind = kind;
      }

      function parseYouTubeId(value: string): string | null {
        const input = value.trim();
        if (/^[A-Za-z0-9_-]{11}$/.test(input)) return input;
        const match = input.match(
          /(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/|\/live\/)([A-Za-z0-9_-]{11})/,
        );
        return match ? match[1] : null;
      }

      function persistVideos(): void {
        try {
          localStorage.setItem(VIDEO_KEY, JSON.stringify(videos));
        } catch {
          // storage can be unavailable; the download still works
        }
      }

      function persistGuides(): void {
        try {
          localStorage.setItem(GUIDE_KEY, JSON.stringify(guides));
        } catch {
          // storage can be unavailable; the download still works
        }
      }

      function jsonFor(data: unknown): string {
        return `${JSON.stringify(data, null, 2)}\n`;
      }

      function renderVideos(): void {
        if (listEl) listEl.innerHTML = "";
        if (countEl) countEl.textContent = String(videos.length);

        if (!videos.length) {
          const empty = document.createElement("p");
          empty.className = "admin-empty";
          empty.textContent = "No videos yet. Add the first one above.";
          listEl?.append(empty);
          return;
        }

        videos.forEach((video, index) => {
          const row = document.createElement("div");
          row.className = "admin-video";

          const image = document.createElement("img");
          image.className = "admin-video__thumb";
          image.src = `https://i.ytimg.com/vi/${video.id}/mqdefault.jpg`;
          image.alt = "";
          image.loading = "lazy";

          const body = document.createElement("div");
          body.className = "admin-video__body";

          const title = document.createElement("p");
          title.className = "admin-video__title";
          title.textContent = video.title;

          const meta = document.createElement("p");
          meta.className = "admin-video__meta";
          meta.textContent = `${video.label || "Episode"} · ${video.id}`;

          body.append(title, meta);

          const actions = document.createElement("div");
          actions.className = "admin-video__actions";

          const up = document.createElement("button");
          up.type = "button";
          up.className = "admin-icon";
          up.textContent = "↑";
          up.title = "Move up";
          up.disabled = index === 0;
          up.addEventListener("click", () => {
            if (index === 0) return;
            [videos[index - 1], videos[index]] = [videos[index], videos[index - 1]];
            persistVideos();
            renderVideos();
          });

          const down = document.createElement("button");
          down.type = "button";
          down.className = "admin-icon";
          down.textContent = "↓";
          down.title = "Move down";
          down.disabled = index === videos.length - 1;
          down.addEventListener("click", () => {
            if (index === videos.length - 1) return;
            [videos[index + 1], videos[index]] = [videos[index], videos[index + 1]];
            persistVideos();
            renderVideos();
          });

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "admin-icon admin-icon--danger";
          remove.textContent = "×";
          remove.title = "Remove";
          remove.addEventListener("click", () => {
            if (!window.confirm(`Remove “${video.title}” from the list?`)) return;
            videos.splice(index, 1);
            persistVideos();
            renderVideos();
          });

          actions.append(up, down, remove);
          row.append(image, body, actions);
          listEl?.append(row);
        });
      }

      function renderGuides(): void {
        if (guideListEl) guideListEl.innerHTML = "";
        if (guideCountEl) guideCountEl.textContent = String(guides.length);

        if (!guides.length) {
          const empty = document.createElement("p");
          empty.className = "admin-empty";
          empty.textContent = "No guides yet. Add the first one above.";
          guideListEl?.append(empty);
          return;
        }

        guides.forEach((guide, index) => {
          const row = document.createElement("div");
          row.className = "admin-guide";

          const body = document.createElement("div");
          body.className = "admin-guide__body";

          const title = document.createElement("p");
          title.className = "admin-guide__title";
          title.textContent = guide.title;

          const desc = document.createElement("p");
          desc.className = "admin-guide__desc";
          desc.textContent = guide.desc;

          const meta = document.createElement("p");
          meta.className = "admin-guide__meta";
          meta.textContent = [guide.status, guide.file].filter(Boolean).join(" · ");

          body.append(title, desc, meta);

          const actions = document.createElement("div");
          actions.className = "admin-video__actions";

          const up = document.createElement("button");
          up.type = "button";
          up.className = "admin-icon";
          up.textContent = "↑";
          up.title = "Move up";
          up.disabled = index === 0;
          up.addEventListener("click", () => {
            if (index === 0) return;
            [guides[index - 1], guides[index]] = [guides[index], guides[index - 1]];
            persistGuides();
            renderGuides();
          });

          const down = document.createElement("button");
          down.type = "button";
          down.className = "admin-icon";
          down.textContent = "↓";
          down.title = "Move down";
          down.disabled = index === guides.length - 1;
          down.addEventListener("click", () => {
            if (index === guides.length - 1) return;
            [guides[index + 1], guides[index]] = [guides[index], guides[index + 1]];
            persistGuides();
            renderGuides();
          });

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "admin-icon admin-icon--danger";
          remove.textContent = "×";
          remove.title = "Remove";
          remove.addEventListener("click", () => {
            if (!window.confirm(`Remove “${guide.title}” from the guides?`)) return;
            guides.splice(index, 1);
            persistGuides();
            renderGuides();
          });

          actions.append(up, down, remove);
          row.append(body, actions);
          guideListEl?.append(row);
        });
      }

      function downloadJson(filename: string, data: unknown): void {
        const blob = new Blob([jsonFor(data)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement("a");
        anchor.href = url;
        anchor.download = filename;
        document.body.append(anchor);
        anchor.click();
        anchor.remove();
        URL.revokeObjectURL(url);
      }

      $("[data-download-videos]")?.addEventListener("click", () => {
        downloadJson("videos.json", videos);
        setStatus("Downloaded videos.json. Replace src/data/videos.json and commit it.", "ok");
      });

      $("[data-download-resources]")?.addEventListener("click", () => {
        downloadJson("resources.json", guides);
        setStatus(
          "Downloaded resources.json. Replace src/data/resources.json and commit it.",
          "ok",
        );
      });

      $("[data-copy-videos]")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(jsonFor(videos));
          setStatus("Copied the video JSON to your clipboard.", "ok");
        } catch {
          setStatus("Could not copy. Use the download button instead.", "error");
        }
      });

      $("[data-copy-resources]")?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(jsonFor(guides));
          setStatus("Copied the guides JSON to your clipboard.", "ok");
        } catch {
          setStatus("Could not copy. Use the download button instead.", "error");
        }
      });

      $("[data-reset]")?.addEventListener("click", () => {
        if (!window.confirm("Reset videos and guides to what is currently published?")) return;
        videos = initialVideos.slice();
        guides = initialResources.slice();
        localStorage.removeItem(VIDEO_KEY);
        localStorage.removeItem(GUIDE_KEY);
        renderVideos();
        renderGuides();
        setStatus("Reset to the published content.", "ok");
      });

      urlInput?.addEventListener("input", () => {
        if (!preview) return;
        const id = parseYouTubeId(urlInput.value);
        if (!id) {
          preview.hidden = true;
          return;
        }
        preview.hidden = false;
        if (previewThumb) previewThumb.src = `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;
        if (previewTitle) previewTitle.textContent = titleInput?.value || "Untitled video";
        if (previewMeta) previewMeta.textContent = `youtube.com/watch?v=${id}`;
      });

      titleInput?.addEventListener("input", () => {
        if (previewTitle) previewTitle.textContent = titleInput.value || "Untitled video";
      });

      addForm?.addEventListener("submit", (event) => {
        event.preventDefault();

        const id = parseYouTubeId(urlInput?.value || "");
        const title = titleInput?.value.trim() || "";

        if (!id) {
          setStatus("That does not look like a YouTube URL.", "error");
          return;
        }
        if (!title) {
          setStatus("Give the video a title.", "error");
          return;
        }

        const label = labelInput?.value.trim();
        videos.push({ id, title, ...(label ? { label } : {}) });
        persistVideos();
        renderVideos();

        if (urlInput) urlInput.value = "";
        if (titleInput) titleInput.value = "";
        if (labelInput) labelInput.value = "";
        if (preview) preview.hidden = true;

        setStatus("Added. Download the file when you are ready to publish.", "ok");
      });

      guideForm?.addEventListener("submit", (event) => {
        event.preventDefault();

        const title = guideTitleInput?.value.trim() || "";
        const desc = guideDescInput?.value.trim() || "";

        if (!title) {
          setStatus("Give the guide a title.", "error");
          return;
        }
        if (!desc) {
          setStatus("Add a short description for the guide.", "error");
          return;
        }

        guides.push({
          title,
          desc,
          file: guideFileInput?.value.trim() || "",
          status: guideStatusInput?.value || "Coming soon",
        });
        persistGuides();
        renderGuides();
        guideForm.reset();
        setStatus("Guide added. Download the file when you are ready to publish.", "ok");
      });

      renderVideos();
      renderGuides();

      if (loadedFromStorage || guidesLoadedFromStorage) {
        setStatus("Loaded your local edits. Download the files to publish them.", "");
      }
    </script>

    <style is:global>
      [hidden] {
        display: none !important;
      }

      .site-header .site-nav a.admin-back {
        display: inline-flex;
      }

      .admin {
        max-width: 900px;
        margin: 0 auto;
        padding: clamp(36px, 6vh, 64px) 24px 96px;
      }

      .admin__intro {
        margin-bottom: 28px;
      }

      .admin__title {
        font-size: clamp(2.4rem, 5vw, 3.4rem);
        line-height: 1;
        margin-top: 10px;
      }

      .admin__lede {
        margin-top: 14px;
        max-width: 62ch;
        color: var(--ink-dim);
        font-size: 0.96rem;
      }

      .admin-card {
        border: 1px solid var(--rule);
        background: var(--bg-card);
        padding: 22px;
        margin-top: 18px;
      }

      .admin-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }

      .admin-card__title {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-bottom: 4px;
      }

      .admin-card__head .admin-card__title {
        margin-bottom: 0;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .admin-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 14px;
      }

      .admin-grid .admin-field {
        margin-top: 0;
      }

      .admin-field label {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }

      .admin-field label span {
        opacity: 0.75;
      }

      .admin-field input,
      .admin-field select {
        width: 100%;
        padding: 10px 12px;
        background: #08080a;
        border: 1px solid var(--rule);
        border-radius: 3px;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 12px;
        transition: border-color 0.25s var(--ease);
      }

      .admin-field input:focus,
      .admin-field select:focus {
        outline: none;
        border-color: rgba(217, 154, 78, 0.65);
      }

      .admin-field input::placeholder {
        color: var(--ink-faint);
        opacity: 0.6;
      }

      .admin-btn {
        padding: 10px 16px;
        background: transparent;
        border: 1px solid var(--rule-strong);
        border-radius: 3px;
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        color: var(--ink-dim);
        cursor: pointer;
        transition: background 0.25s var(--ease), color 0.25s var(--ease),
          border-color 0.25s var(--ease);
      }

      .admin-btn:hover {
        color: var(--ink);
        border-color: rgba(217, 154, 78, 0.55);
        background: var(--amber-wash);
      }

      .admin-btn--primary {
        background: var(--amber);
        border-color: var(--amber);
        color: #130f09;
        font-weight: 500;
      }

      .admin-btn--primary:hover {
        background: var(--amber-bright);
        border-color: var(--amber-bright);
        color: #130f09;
      }

      .admin-field--submit {
        justify-content: flex-end;
      }

      .admin-preview {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--rule);
      }

      .admin-preview img {
        width: 128px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: 1px solid var(--rule);
      }

      .admin-preview__title {
        font-size: 0.92rem;
        font-weight: 500;
      }

      .admin-preview__meta {
        margin-top: 4px;
        font-family: var(--mono);
        font-size: 9.5px;
        color: var(--ink-faint);
      }

      .admin-count {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--amber);
      }

      .admin-list {
        display: flex;
        flex-direction: column;
      }

      .admin-video {
        display: grid;
        grid-template-columns: 128px minmax(0, 1fr) auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-top: 1px solid var(--rule);
      }

      .admin-video:first-child {
        border-top: 0;
      }

      .admin-video__thumb {
        width: 128px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: 1px solid var(--rule);
      }

      .admin-video__title {
        font-size: 0.94rem;
        font-weight: 500;
        line-height: 1.45;
      }

      .admin-video__meta {
        margin-top: 5px;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.04em;
        color: var(--ink-faint);
      }

      .admin-video__actions {
        display: flex;
        gap: 6px;
      }

      .admin-guide {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-top: 1px solid var(--rule);
      }

      .admin-guide:first-child {
        border-top: 0;
      }

      .admin-guide__title {
        font-size: 0.94rem;
        font-weight: 500;
        line-height: 1.45;
      }

      .admin-guide__desc {
        margin-top: 4px;
        font-size: 0.86rem;
        line-height: 1.55;
        color: var(--ink-dim);
      }

      .admin-guide__meta {
        margin-top: 6px;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.04em;
        color: var(--ink-faint);
      }

      .admin-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 3px;
        color: var(--ink-faint);
        font-family: var(--mono);
        font-size: 13px;
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s, background 0.2s;
      }

      .admin-icon:hover:not(:disabled) {
        color: var(--amber);
        border-color: rgba(217, 154, 78, 0.5);
        background: var(--amber-wash);
      }

      .admin-icon:disabled {
        opacity: 0.3;
        cursor: default;
      }

      .admin-icon--danger:hover:not(:disabled) {
        color: var(--clay);
        border-color: rgba(196, 111, 90, 0.55);
        background: rgba(196, 111, 90, 0.08);
      }

      .admin-empty {
        padding: 22px 0;
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-faint);
        border-top: 1px solid var(--rule);
      }

      .admin-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 20px;
      }

      .admin-status {
        min-height: 18px;
        margin-top: 14px;
        font-family: var(--mono);
        font-size: 10.5px;
        line-height: 1.7;
        letter-spacing: 0.03em;
        color: var(--ink-faint);
      }

      .admin-status[data-kind="ok"] {
        color: var(--sage);
      }

      .admin-status[data-kind="error"] {
        color: var(--clay);
      }

      .admin-note {
        margin-top: 28px;
        padding-top: 18px;
        border-top: 1px solid var(--rule);
        display: grid;
        gap: 6px;
      }

      .admin-note p {
        font-family: var(--mono);
        font-size: 10px;
        line-height: 1.8;
        letter-spacing: 0.02em;
        color: var(--ink-faint);
      }

      .admin-note code {
        color: var(--ink-dim);
        font-family: var(--mono);
        font-size: 10px;
      }

      @media (max-width: 640px) {
        .admin {
          padding-left: 18px;
          padding-right: 18px;
        }

        .admin-grid {
          grid-template-columns: 1fr;
        }

        .admin-video {
          grid-template-columns: 96px minmax(0, 1fr);
        }

        .admin-video__thumb {
          width: 96px;
        }

        .admin-video__actions {
          grid-column: 1 / -1;
          justify-content: flex-end;
        }

        .admin-guide {
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .admin-guide .admin-video__actions {
          justify-content: flex-end;
        }
      }
    </style>
  </body>
</html>
