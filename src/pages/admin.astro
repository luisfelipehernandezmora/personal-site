---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />
    <title>Video admin — Luis Felipe Hernández Mora</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="monogram" href="/">LH — applied ai</a>
        <nav class="site-nav" aria-label="Admin">
          <a class="admin-back" href="/">← Back to site</a>
        </nav>
      </div>
    </header>

    <main class="admin">
      <div class="admin__intro">
        <p class="eyebrow"><span style="color:var(--amber)">admin</span><span>Videos</span></p>
        <h1 class="admin__title display">Video admin</h1>
        <p class="admin__lede">
          Add a YouTube link and it is committed to the site’s repository. Vercel rebuilds and
          the public page updates in about a minute.
        </p>
      </div>

      <section class="admin-card" data-setup>
        <p class="admin-card__title">Connect to GitHub</p>
        <p class="admin-card__note">
          Use a <strong>fine-grained personal access token</strong> limited to this repository,
          with <strong>Contents: Read and write</strong>. It is kept in this browser only.
        </p>

        <div class="admin-grid">
          <div class="admin-field">
            <label for="owner">Repository owner</label>
            <input id="owner" autocomplete="off" spellcheck="false" />
          </div>
          <div class="admin-field">
            <label for="repo">Repository</label>
            <input id="repo" autocomplete="off" spellcheck="false" />
          </div>
          <div class="admin-field">
            <label for="branch">Branch</label>
            <input id="branch" autocomplete="off" spellcheck="false" />
          </div>
          <div class="admin-field">
            <label for="path">Data file</label>
            <input id="path" autocomplete="off" spellcheck="false" />
          </div>
        </div>

        <div class="admin-field admin-field--wide">
          <label for="token">Personal access token</label>
          <input
            id="token"
            type="password"
            autocomplete="off"
            spellcheck="false"
            placeholder="github_pat_…"
          />
        </div>

        <div class="admin-row">
          <label class="admin-check">
            <input id="remember" type="checkbox" />
            Keep the token on this device
          </label>
          <div class="admin-row__actions">
            <a
              class="admin-link"
              href="https://github.com/settings/personal-access-tokens/new"
              target="_blank"
              rel="noopener">Create a token ↗</a
            >
            <button class="admin-btn admin-btn--primary" type="button" data-connect>Connect</button>
          </div>
        </div>

        <p class="admin-status" data-status role="status" aria-live="polite"></p>
      </section>

      <section class="admin-workspace" data-workspace hidden>
        <div class="admin-bar">
          <p class="admin-repo" data-repo-info></p>
          <button class="admin-btn" type="button" data-disconnect>Disconnect</button>
        </div>

        <p class="admin-status" data-workspace-status role="status" aria-live="polite"></p>

        <section class="admin-card">
          <p class="admin-card__title">Add a video</p>
          <form class="admin-form" data-add-form>
            <div class="admin-grid">
              <div class="admin-field">
                <label for="url">YouTube URL</label>
                <input id="url" required placeholder="https://www.youtube.com/watch?v=…" />
              </div>
              <div class="admin-field">
                <label for="title">Title</label>
                <input id="title" required placeholder="What the episode is about" />
              </div>
            </div>
            <div class="admin-grid">
              <div class="admin-field">
                <label for="label">Episode label <span>optional</span></label>
                <input id="label" placeholder="Episode 01" />
              </div>
              <div class="admin-field admin-field--submit">
                <button class="admin-btn admin-btn--primary" type="submit">Add video</button>
              </div>
            </div>
          </form>
          <div class="admin-preview" data-preview hidden>
            <img data-preview-thumb alt="" />
            <div>
              <p class="admin-preview__title" data-preview-title></p>
              <p class="admin-preview__meta" data-preview-meta></p>
            </div>
          </div>
        </section>

        <section class="admin-card">
          <div class="admin-card__head">
            <p class="admin-card__title">Published videos</p>
            <span class="admin-count" data-count>0</span>
          </div>
          <div class="admin-list" data-list></div>
        </section>
      </section>
    </main>

    <script>
      interface Video {
        id: string;
        title: string;
        label?: string;
      }

      interface Config {
        owner: string;
        repo: string;
        branch: string;
        path: string;
      }

      const CFG_KEY = "lhm-admin-config";
      const TOKEN_KEY = "lhm-admin-token";

      const $ = <T extends HTMLElement>(selector: string): T | null =>
        document.querySelector<T>(selector);

      const setup = $("[data-setup]");
      const workspace = $("[data-workspace]");
      const statusEl = $("[data-status]");
      const workspaceStatus = $("[data-workspace-status]");
      const repoInfo = $("[data-repo-info]");
      const listEl = $("[data-list]");
      const countEl = $("[data-count]");
      const preview = $("[data-preview]");
      const previewThumb = $<HTMLImageElement>("[data-preview-thumb]");
      const previewTitle = $("[data-preview-title]");
      const previewMeta = $("[data-preview-meta]");

      const ownerInput = $<HTMLInputElement>("#owner");
      const repoInput = $<HTMLInputElement>("#repo");
      const branchInput = $<HTMLInputElement>("#branch");
      const pathInput = $<HTMLInputElement>("#path");
      const tokenInput = $<HTMLInputElement>("#token");
      const rememberInput = $<HTMLInputElement>("#remember");

      const addForm = $<HTMLFormElement>("[data-add-form]");
      const urlInput = $<HTMLInputElement>("#url");
      const titleInput = $<HTMLInputElement>("#title");
      const labelInput = $<HTMLInputElement>("#label");

      let config: Config | null = null;
      let token = "";
      let videos: Video[] = [];
      let sha: string | null = null;
      let busy = false;

      function setStatus(message: string, kind: "ok" | "error" | "" = ""): void {
        if (!statusEl) return;
        statusEl.textContent = message;
        statusEl.dataset.kind = kind;
      }

      function setWorkspaceStatus(message: string, kind: "ok" | "error" | "" = ""): void {
        if (!workspaceStatus) return;
        workspaceStatus.textContent = message;
        workspaceStatus.dataset.kind = kind;
      }

      function parseYouTubeId(value: string): string | null {
        const input = value.trim();
        if (/^[A-Za-z0-9_-]{11}$/.test(input)) return input;
        const match = input.match(
          /(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/|\/live\/)([A-Za-z0-9_-]{11})/,
        );
        return match ? match[1] : null;
      }

      function encodeBase64(text: string): string {
        const bytes = new TextEncoder().encode(text);
        let binary = "";
        for (const byte of bytes) binary += String.fromCharCode(byte);
        return btoa(binary);
      }

      function decodeBase64(value: string): string {
        const binary = atob(value.replace(/\s/g, ""));
        const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      }

      function filePath(): string {
        if (!config) return "";
        return config.path
          .split("/")
          .filter(Boolean)
          .map(encodeURIComponent)
          .join("/");
      }

      async function github(path: string, init: RequestInit = {}): Promise<Response> {
        const headers = new Headers(init.headers);
        headers.set("Authorization", `Bearer ${token}`);
        headers.set("Accept", "application/vnd.github+json");
        headers.set("X-GitHub-Api-Version", "2022-11-28");
        if (init.body) headers.set("Content-Type", "application/json");

        return fetch(`https://api.github.com${path}`, { ...init, headers });
      }

      async function readError(response: Response): Promise<string> {
        try {
          const data = await response.json();
          return data.message || `GitHub returned ${response.status}`;
        } catch {
          return `GitHub returned ${response.status}`;
        }
      }

      async function loadVideos(): Promise<void> {
        if (!config) throw new Error("Not connected");
        const path = `/repos/${config.owner}/${config.repo}/contents/${filePath()}?ref=${encodeURIComponent(
          config.branch,
        )}`;
        const response = await github(path);

        if (response.status === 404) {
          const repoCheck = await github(`/repos/${config.owner}/${config.repo}`);
          if (!repoCheck.ok) {
            throw new Error("Repository not found, or the token has no access to it");
          }
          videos = [];
          sha = null;
          return;
        }
        if (!response.ok) throw new Error(await readError(response));

        const data = await response.json();
        sha = data.sha;
        const parsed = JSON.parse(decodeBase64(data.content));
        videos = Array.isArray(parsed)
          ? parsed.filter(
              (item): item is Video =>
                item && typeof item.id === "string" && typeof item.title === "string",
            )
          : [];
      }

      async function commit(message: string): Promise<string> {
        if (!config) throw new Error("Not connected");
        const body: Record<string, unknown> = {
          message,
          content: encodeBase64(`${JSON.stringify(videos, null, 2)}\n`),
          branch: config.branch,
        };
        if (sha) body.sha = sha;

        const response = await github(
          `/repos/${config.owner}/${config.repo}/contents/${filePath()}`,
          { method: "PUT", body: JSON.stringify(body) },
        );
        if (!response.ok) throw new Error(await readError(response));

        const data = await response.json();
        sha = data.content?.sha || sha;
        return data.commit?.html_url || "";
      }

      function setBusy(value: boolean): void {
        busy = value;
        document.querySelectorAll<HTMLButtonElement>(".admin-btn").forEach((button) => {
          if (button.dataset.disconnect === undefined) button.disabled = value;
        });
      }

      async function save(message: string): Promise<boolean> {
        if (busy) return false;
        setBusy(true);
        setWorkspaceStatus("Saving…");
        try {
          const url = await commit(message);
          setWorkspaceStatus("Saved. Vercel will rebuild in a moment.", "ok");
          if (url && workspaceStatus) {
            workspaceStatus.append(" ");
            const link = document.createElement("a");
            link.href = url;
            link.target = "_blank";
            link.rel = "noopener";
            link.textContent = "View commit ↗";
            workspaceStatus.append(link);
          }
          render();
          return true;
        } catch (error) {
          setWorkspaceStatus(`Save failed: ${(error as Error).message}`, "error");
          try {
            await loadVideos();
            render();
          } catch {
            // leave the list as-is if the resync also fails
          }
          return false;
        } finally {
          setBusy(false);
        }
      }

      function render(): void {
        if (listEl) listEl.innerHTML = "";
        if (countEl) countEl.textContent = String(videos.length);

        if (!videos.length) {
          const empty = document.createElement("p");
          empty.className = "admin-empty";
          empty.textContent = "No videos yet. Add the first one above.";
          listEl?.append(empty);
          return;
        }

        videos.forEach((video, index) => {
          const row = document.createElement("div");
          row.className = "admin-video";

          const image = document.createElement("img");
          image.className = "admin-video__thumb";
          image.src = `https://i.ytimg.com/vi/${video.id}/mqdefault.jpg`;
          image.alt = "";
          image.loading = "lazy";

          const body = document.createElement("div");
          body.className = "admin-video__body";

          const title = document.createElement("p");
          title.className = "admin-video__title";
          title.textContent = video.title;

          const meta = document.createElement("p");
          meta.className = "admin-video__meta";
          meta.textContent = `${video.label || "Episode"} · ${video.id}`;

          body.append(title, meta);

          const actions = document.createElement("div");
          actions.className = "admin-video__actions";

          const up = document.createElement("button");
          up.type = "button";
          up.className = "admin-icon";
          up.textContent = "↑";
          up.title = "Move up";
          up.disabled = index === 0;
          up.addEventListener("click", () => {
            if (busy || index === 0) return;
            [videos[index - 1], videos[index]] = [videos[index], videos[index - 1]];
            void save(`Reorder videos (admin)`);
          });

          const down = document.createElement("button");
          down.type = "button";
          down.className = "admin-icon";
          down.textContent = "↓";
          down.title = "Move down";
          down.disabled = index === videos.length - 1;
          down.addEventListener("click", () => {
            if (busy || index === videos.length - 1) return;
            [videos[index + 1], videos[index]] = [videos[index], videos[index + 1]];
            void save(`Reorder videos (admin)`);
          });

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "admin-icon admin-icon--danger";
          remove.textContent = "×";
          remove.title = "Remove";
          remove.addEventListener("click", () => {
            if (busy) return;
            if (!window.confirm(`Remove “${video.title}” from the site?`)) return;
            videos.splice(index, 1);
            void save(`Remove video: ${video.title}`);
          });

          actions.append(up, down, remove);
          row.append(image, body, actions);
          listEl?.append(row);
        });
      }

      function showWorkspace(): void {
        if (setup) setup.hidden = true;
        if (workspace) workspace.hidden = false;
        if (repoInfo && config) {
          repoInfo.textContent = `${config.owner}/${config.repo} · ${config.branch} · ${config.path}`;
        }
        render();
      }

      function persist(): void {
        if (!config) return;
        localStorage.setItem(CFG_KEY, JSON.stringify(config));

        const remember = Boolean(rememberInput?.checked);
        if (remember) {
          localStorage.setItem(TOKEN_KEY, token);
          sessionStorage.removeItem(TOKEN_KEY);
        } else {
          sessionStorage.setItem(TOKEN_KEY, token);
          localStorage.removeItem(TOKEN_KEY);
        }
      }

      function restore(): void {
        try {
          const stored = localStorage.getItem(CFG_KEY);
          if (stored) {
            const parsed = JSON.parse(stored) as Partial<Config>;
            config = {
              owner: parsed.owner || "",
              repo: parsed.repo || "",
              branch: parsed.branch || "main",
              path: parsed.path || "src/data/videos.json",
            };
          }
          token =
            localStorage.getItem(TOKEN_KEY) || sessionStorage.getItem(TOKEN_KEY) || "";
        } catch {
          config = null;
          token = "";
        }

        if (ownerInput) ownerInput.value = config?.owner || "luisfelipehernandezmora";
        if (repoInput) repoInput.value = config?.repo || "luishernandezmora";
        if (branchInput) branchInput.value = config?.branch || "main";
        if (pathInput) pathInput.value = config?.path || "src/data/videos.json";
        if (tokenInput) tokenInput.value = token;
        if (rememberInput) rememberInput.checked = Boolean(localStorage.getItem(TOKEN_KEY));
      }

      async function connect(): Promise<void> {
        const next: Config = {
          owner: ownerInput?.value.trim() || "",
          repo: repoInput?.value.trim() || "",
          branch: branchInput?.value.trim() || "main",
          path: pathInput?.value.trim() || "src/data/videos.json",
        };
        const nextToken = tokenInput?.value.trim() || "";

        if (!next.owner || !next.repo) {
          setStatus("Enter the repository owner and name.", "error");
          return;
        }
        if (!nextToken) {
          setStatus("Enter a personal access token.", "error");
          return;
        }

        config = next;
        token = nextToken;
        persist();
        setStatus("Connecting…");

        try {
          await loadVideos();
          setStatus("");
          showWorkspace();
          setWorkspaceStatus(
            videos.length
              ? `Connected. ${videos.length} video${videos.length === 1 ? "" : "s"} found.`
              : "Connected. No videos yet.",
            "ok",
          );
        } catch (error) {
          setStatus(
            `Could not connect: ${(error as Error).message}. Check the repository and token permissions.`,
            "error",
          );
        }
      }

      $("[data-connect]")?.addEventListener("click", () => void connect());

      $("[data-disconnect]")?.addEventListener("click", () => {
        localStorage.removeItem(CFG_KEY);
        localStorage.removeItem(TOKEN_KEY);
        sessionStorage.removeItem(TOKEN_KEY);
        window.location.reload();
      });

      urlInput?.addEventListener("input", () => {
        if (!preview) return;
        const id = parseYouTubeId(urlInput.value);
        if (!id) {
          preview.hidden = true;
          return;
        }
        preview.hidden = false;
        if (previewThumb) previewThumb.src = `https://i.ytimg.com/vi/${id}/mqdefault.jpg`;
        if (previewTitle) previewTitle.textContent = titleInput?.value || "Untitled video";
        if (previewMeta) previewMeta.textContent = `youtube.com/watch?v=${id}`;
      });

      titleInput?.addEventListener("input", () => {
        if (previewTitle) previewTitle.textContent = titleInput.value || "Untitled video";
      });

      addForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (busy) return;

        const id = parseYouTubeId(urlInput?.value || "");
        const title = titleInput?.value.trim() || "";

        if (!id) {
          setWorkspaceStatus("That does not look like a YouTube URL.", "error");
          return;
        }
        if (!title) {
          setWorkspaceStatus("Give the video a title.", "error");
          return;
        }

        const label = labelInput?.value.trim();
        videos.push({ id, title, ...(label ? { label } : {}) });

        void (async () => {
          const saved = await save(`Add video: ${title}`);
          if (!saved) return;
          if (urlInput) urlInput.value = "";
          if (titleInput) titleInput.value = "";
          if (labelInput) labelInput.value = "";
          if (preview) preview.hidden = true;
        })();
      });

      restore();

      if (config && token) {
        setStatus("Restoring your session…");
        void loadVideos()
          .then(() => {
            setStatus("");
            showWorkspace();
            setWorkspaceStatus("Connected.", "ok");
          })
          .catch((error) => {
            setStatus(
              `Session expired: ${(error as Error).message}. Reconnect with a valid token.`,
              "error",
            );
          });
      }
    </script>

    <style is:global>
      [hidden] {
        display: none !important;
      }

      .site-header .site-nav a.admin-back {
        display: inline-flex;
      }

      .admin {
        max-width: 900px;
        margin: 0 auto;
        padding: clamp(36px, 6vh, 64px) 24px 96px;
      }

      .admin__intro {
        margin-bottom: 28px;
      }

      .admin__title {
        font-size: clamp(2.4rem, 5vw, 3.4rem);
        line-height: 1;
        margin-top: 10px;
      }

      .admin__lede {
        margin-top: 14px;
        max-width: 60ch;
        color: var(--ink-dim);
        font-size: 0.96rem;
      }

      .admin-card {
        border: 1px solid var(--rule);
        background: var(--bg-card);
        padding: 22px;
        margin-top: 18px;
      }

      .admin-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
      }

      .admin-card__title {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-dim);
        margin-bottom: 4px;
      }

      .admin-card__head .admin-card__title {
        margin-bottom: 0;
      }

      .admin-card__note {
        margin: 8px 0 18px;
        max-width: 64ch;
        color: var(--ink-faint);
        font-size: 0.88rem;
        line-height: 1.65;
      }

      .admin-card__note strong {
        color: var(--ink-dim);
        font-weight: 500;
      }

      .admin-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .admin-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 14px;
      }

      .admin-grid .admin-field {
        margin-top: 0;
      }

      .admin-field--wide {
        margin-top: 16px;
      }

      .admin-field label {
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: var(--ink-faint);
      }

      .admin-field label span {
        opacity: 0.75;
      }

      .admin-field input {
        width: 100%;
        padding: 10px 12px;
        background: #08080a;
        border: 1px solid var(--rule);
        border-radius: 3px;
        color: var(--ink);
        font-family: var(--mono);
        font-size: 12px;
        transition: border-color 0.25s var(--ease);
      }

      .admin-field input:focus {
        outline: none;
        border-color: rgba(217, 154, 78, 0.65);
      }

      .admin-field input::placeholder {
        color: var(--ink-faint);
        opacity: 0.6;
      }

      .admin-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-top: 18px;
      }

      .admin-row__actions {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
      }

      .admin-check {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
        cursor: pointer;
      }

      .admin-check input {
        accent-color: var(--amber);
      }

      .admin-link {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.06em;
        color: var(--ink-dim);
        border-bottom: 1px solid var(--rule-strong);
        padding-bottom: 2px;
      }

      .admin-link:hover {
        color: var(--amber);
        border-color: var(--amber);
      }

      .admin-btn {
        padding: 10px 16px;
        background: transparent;
        border: 1px solid var(--rule-strong);
        border-radius: 3px;
        font-family: var(--mono);
        font-size: 10.5px;
        letter-spacing: 0.06em;
        color: var(--ink-dim);
        cursor: pointer;
        transition: background 0.25s var(--ease), color 0.25s var(--ease),
          border-color 0.25s var(--ease);
      }

      .admin-btn:hover:not(:disabled) {
        color: var(--ink);
        border-color: rgba(217, 154, 78, 0.55);
        background: var(--amber-wash);
      }

      .admin-btn:disabled {
        opacity: 0.45;
        cursor: default;
      }

      .admin-btn--primary {
        background: var(--amber);
        border-color: var(--amber);
        color: #130f09;
        font-weight: 500;
      }

      .admin-btn--primary:hover:not(:disabled) {
        background: var(--amber-bright);
        border-color: var(--amber-bright);
        color: #130f09;
      }

      .admin-status {
        min-height: 18px;
        margin-top: 14px;
        font-family: var(--mono);
        font-size: 10.5px;
        line-height: 1.7;
        letter-spacing: 0.03em;
        color: var(--ink-faint);
      }

      .admin-status[data-kind="ok"] {
        color: var(--sage);
      }

      .admin-status[data-kind="error"] {
        color: var(--clay);
      }

      .admin-status a {
        color: var(--amber);
        border-bottom: 1px solid rgba(217, 154, 78, 0.4);
      }

      .admin-workspace {
        margin-top: 26px;
      }

      .admin-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--rule);
      }

      .admin-repo {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
        overflow-wrap: anywhere;
      }

      .admin-form {
        margin-top: 14px;
      }

      .admin-field--submit {
        justify-content: flex-end;
      }

      .admin-preview {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--rule);
      }

      .admin-preview img {
        width: 128px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: 1px solid var(--rule);
      }

      .admin-preview__title {
        font-size: 0.92rem;
        font-weight: 500;
      }

      .admin-preview__meta {
        margin-top: 4px;
        font-family: var(--mono);
        font-size: 9.5px;
        color: var(--ink-faint);
      }

      .admin-count {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--amber);
      }

      .admin-list {
        display: flex;
        flex-direction: column;
      }

      .admin-video {
        display: grid;
        grid-template-columns: 128px minmax(0, 1fr) auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-top: 1px solid var(--rule);
      }

      .admin-video:first-child {
        border-top: 0;
      }

      .admin-video__thumb {
        width: 128px;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        border: 1px solid var(--rule);
      }

      .admin-video__title {
        font-size: 0.94rem;
        font-weight: 500;
        line-height: 1.45;
      }

      .admin-video__meta {
        margin-top: 5px;
        font-family: var(--mono);
        font-size: 9.5px;
        letter-spacing: 0.04em;
        color: var(--ink-faint);
      }

      .admin-video__actions {
        display: flex;
        gap: 6px;
      }

      .admin-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        background: transparent;
        border: 1px solid var(--rule);
        border-radius: 3px;
        color: var(--ink-faint);
        font-family: var(--mono);
        font-size: 13px;
        cursor: pointer;
        transition: color 0.2s, border-color 0.2s, background 0.2s;
      }

      .admin-icon:hover:not(:disabled) {
        color: var(--amber);
        border-color: rgba(217, 154, 78, 0.5);
        background: var(--amber-wash);
      }

      .admin-icon:disabled {
        opacity: 0.3;
        cursor: default;
      }

      .admin-icon--danger:hover:not(:disabled) {
        color: var(--clay);
        border-color: rgba(196, 111, 90, 0.55);
        background: rgba(196, 111, 90, 0.08);
      }

      .admin-empty {
        padding: 22px 0;
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--ink-faint);
        border-top: 1px solid var(--rule);
      }

      @media (max-width: 640px) {
        .admin {
          padding-left: 18px;
          padding-right: 18px;
        }

        .admin-grid {
          grid-template-columns: 1fr;
        }

        .admin-video {
          grid-template-columns: 96px minmax(0, 1fr);
        }

        .admin-video__thumb {
          width: 96px;
        }

        .admin-video__actions {
          grid-column: 1 / -1;
          justify-content: flex-end;
        }
      }
    </style>
  </body>
</html>
